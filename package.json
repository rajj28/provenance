{
  "name": "portfolio-autopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"next dev\" \"tsx src/worker.ts\"",
    "worker": "tsx src/worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "octokit": "^5.0.5",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
