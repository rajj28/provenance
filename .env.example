# ---- required ----
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"
REDIS_URL="redis://127.0.0.1:6379"
APP_URL="http://localhost:3000"

# Generate each of these separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In production these must be >= 32 chars and not the placeholder text below,
# or the app refuses to boot (src/lib/env.ts).
AUTH_SECRET="replace-with-a-long-random-string"
APP_ENCRYPTION_KEY="replace-with-a-long-random-string"
CRON_SECRET="replace-with-a-long-random-string"

# ---- GitHub (optional; a personal access token works without OAuth) ----
# https://github.com/settings/developers
# Homepage: $APP_URL   Callback: $APP_URL/api/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# ---- LinkedIn (optional; publishing only) ----
# https://www.linkedin.com/developers/apps
# Add BOTH products to the app, then wait for them to show as granted:
#   1. "Sign In with LinkedIn using OpenID Connect"  -> openid, profile, email
#   2. "Share on LinkedIn"                           -> w_member_social
# Authorized redirect URL: $APP_URL/api/integrations/linkedin/callback
#
# Reading your LinkedIn posts or profile history is NOT possible: that needs
# r_member_social, which LinkedIn restricts to approved partners. Import that
# evidence manually instead.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# LinkedIn versions its API by month (YYYYMM). Bump deliberately.
LINKEDIN_API_VERSION="202608"

# ---- curation (optional) ----
# Without this key, a transparent heuristic curator runs instead.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---- tuning (optional; defaults shown) ----
SYNC_CONCURRENCY="4"
QUEUE_ENQUEUE_TIMEOUT_MS="3000"
CRON_BATCH_SIZE="200"
AUTH_RATE_LIMIT="10"
AUTH_RATE_WINDOW_S="300"
